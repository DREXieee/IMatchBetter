{
    "name": "imatchbetter/imatchbetter",
    "description": "IMatchBetter job board platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "phpmailer/phpmailer": "^6.9",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "IMatchBetter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IMatchBetter\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "scripts": {
        "test": "phpunit"
    }
}
